# Copy this file to .env and edit as needed.

# LLM Provider Options:
# "mock"      -> no API key needed, deterministic offline demo (default)
# "anthropic" -> uses Claude API for attempt + reflection steps
# "openai"    -> uses OpenAI GPT-4o / GPT-4o-mini
# "gemini"    -> uses Google Gemini 2.0 Flash
# "ollama"    -> uses local Ollama models (offline/self-hosted)
LLM_PROVIDER=mock

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: override where SQLite memory is stored
# SELF_EVOLVE_DB=./data.db

# Optional: port for uvicorn
PORT=8000
